PORT=4000
# Where uploaded PDFs/thumbnails are written.
UPLOAD_DIR=./uploads
# Where the JSON data store (db.json) is written.
DATA_DIR=./data
CLIENT_ORIGIN=http://localhost:5173

# Apryse Server SDK license key (trial keys work for development).
# Get one at https://docs.apryse.com/core/guides/get-started/trial-key
APRYSE_LICENSE_KEY=YOUR_APRYSE_LICENSE_KEY

# Directory holding the vendored Apryse add-on modules (OCR / ICR handwriting).
# See server/vendor/apryse/README.md for how to install them.
APRYSE_MODULES_DIR=./vendor/apryse
